{
  "info": {
    "_postman_id": "60ee2c73-4bb7-41bf-ac50-97511d5575c7",
    "name": "Global Invoice API",
    "description": "Coleccion para validar autenticacion, facturas y dashboard. Configura operatorPassword y auditorPassword en las variables de la coleccion antes de ejecutar los logins. Ejecuta primero los dos logins: sus pruebas guardan los JWT que usan las demas solicitudes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "operatorUsername",
      "value": "operator",
      "type": "string"
    },
    {
      "key": "operatorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditorUsername",
      "value": "auditor",
      "type": "string"
    },
    {
      "key": "auditorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "nonExistentInvoiceId",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login - Operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna 200 y un JWT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('operatorToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"{{operatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Autentica al usuario OPERATOR y guarda su token en operatorToken."
          }
        },
        {
          "name": "Login - Auditor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna 200 y un JWT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('auditorToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auditorUsername}}\",\n  \"password\": \"{{auditorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Autentica al usuario AUDITOR y guarda su token en auditorToken."
          }
        },
        {
          "name": "Login - Credenciales invalidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza las credenciales con 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().message).to.eql('Credenciales invalidas');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"contrasena-invalida\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login - Solicitud invalida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valida campos obligatorios con 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errors).to.have.property('username');",
                  "    pm.expect(pm.response.json().errors).to.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Facturas",
      "item": [
        {
          "name": "Crear factura NATIONAL - Operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea una factura NATIONAL con 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.type).to.eql('NATIONAL');",
                  "    pm.expect(response.subtotal).to.eql(100000);",
                  "    pm.expect(response.total).to.eql(119000);",
                  "});",
                  "pm.collectionVariables.set('invoiceId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNumber\": \"NATIONAL-{{$guid}}\",\n  \"type\": \"NATIONAL\",\n  \"subtotal\": 100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/invoices"
          }
        },
