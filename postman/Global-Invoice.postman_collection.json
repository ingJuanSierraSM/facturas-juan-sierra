        {
          "name": "Consultar detalle de la ultima factura - Auditor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna el detalle y el total en letras', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.id).to.eql(Number(pm.collectionVariables.get('invoiceId')));",
                  "    pm.expect(response.totalInWords).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auditorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}",
            "description": "Ejecuta antes alguna solicitud de creacion. Esta llamada consume el proveedor SOAP DataFlex; si el proveedor externo no esta disponible, la API responde 502."
          }
        },
        {
          "name": "Consultar factura inexistente - 404",
          "event": [
